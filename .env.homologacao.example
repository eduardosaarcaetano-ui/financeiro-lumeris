# Nunca coloque credenciais reais neste arquivo de exemplo.
APP_ENV=homologacao
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DISABLE_EXTERNAL_INTEGRATIONS=true
DISABLE_EMAIL_DELIVERY=true
DISABLE_BANK_SYNC=true
DISABLE_NFSE=true
DISABLE_CONTRACT_WEBHOOKS=true
